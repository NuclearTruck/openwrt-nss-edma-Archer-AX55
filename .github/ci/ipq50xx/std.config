# Group "std": boards with 512 MB or 1 GB of RAM. ath11k picks its host memory profile at run
# time from the RAM size (1G here); qca-nss-drv is built MEDIUM (README.ipq50xx.md, "Memory profiles").
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_tplink_archer-ax55-v1=y
